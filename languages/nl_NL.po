#: inc/class-githeme-contrast-control.php:31
msgid "WCAG AA reference for normal-size text. These results do not assess logos, icons, component borders or the whole site."
msgstr "WCAG AA-referentie voor tekst van normale grootte. Deze resultaten beoordelen geen logo’s, pictogrammen, componentranden of de site als geheel."

#: inc/class-githeme-contrast-control.php:43
msgid "Button text uses whichever of black or white has better contrast. Results are compared before rounding. Link identification, hover states and plugin styles need separate checks. Contrast advice does not block saving."
msgstr "De knoptekst is zwart of wit, afhankelijk van welke kleur het beste contrast biedt. De vergelijking gebeurt vóór het afronden. De herkenbaarheid van links, hoverstatussen en pluginstijlen moeten afzonderlijk worden gecontroleerd. De contrastadviezen verhinderen het opslaan niet."

#: inc/class-githeme-contrast-control.php:44
msgid "Values shown were calculated when this screen loaded. Reload after saving to check updated results."
msgstr "De getoonde waarden zijn berekend toen dit scherm werd geladen. Laad het scherm na het opslaan opnieuw om de bijgewerkte resultaten te controleren."

#: inc/class-githeme-featured-posts-widget.php:8
msgid "GiTheme – Featured Posts"
msgstr "GiTheme – Uitgelichte berichten"

#: inc/class-githeme-featured-posts-widget.php:8
msgid "Post cards selected by date, category, or an ordered list of IDs."
msgstr "Berichtkaarten geselecteerd op datum, categorie of een geordende lijst met ID’s."

#: inc/class-githeme-featured-posts-widget.php:108
#: inc/class-githeme-gallery-slider-widget.php:66
msgid "Title (optional)"
msgstr "Titel (optioneel)"

#: inc/class-githeme-featured-posts-widget.php:110
msgid "Selection"
msgstr "Selectie"

#: inc/class-githeme-featured-posts-widget.php:112
msgid "Latest published posts"
msgstr "Nieuwste gepubliceerde berichten"

#: inc/class-githeme-featured-posts-widget.php:112
msgid "Posts in a category"
msgstr "Berichten uit een categorie"

#: inc/class-githeme-featured-posts-widget.php:112
msgid "Manual post IDs"
msgstr "Handmatig geselecteerde bericht-ID’s"

#: inc/class-githeme-featured-posts-widget.php:116
msgid "Category (category mode)"
msgstr "Categorie (categoriemodus)"

#: inc/class-githeme-featured-posts-widget.php:117
msgid "Select a category"
msgstr "Selecteer een categorie"

#: inc/class-githeme-featured-posts-widget.php:118
msgid "Number of posts (automatic modes, 1–50)"
msgstr "Aantal berichten (automatische modi, 1–50)"

#: inc/class-githeme-featured-posts-widget.php:120
msgid "Post IDs (manual mode)"
msgstr "Bericht-ID’s (handmatige modus)"

#: inc/class-githeme-featured-posts-widget.php:122
msgid "Comma-separated IDs, displayed in this order. Missing or unpublished posts are skipped; the automatic count is ignored."
msgstr "Door komma’s gescheiden ID’s, weergegeven in deze volgorde. Ontbrekende of niet-gepubliceerde berichten worden overgeslagen; het aantal voor automatische modi wordt genegeerd."

#: inc/class-githeme-gallery-slider-widget.php:8
msgid "GiTheme – Gallery Slider"
msgstr "GiTheme – Galerijslider"

#: inc/class-githeme-gallery-slider-widget.php:8
msgid "A native gallery slider using an ordered list of image attachment IDs."
msgstr "Een ingebouwde galerijslider met een geordende lijst met ID’s van afbeeldingsbijlagen."

#: inc/class-githeme-gallery-slider-widget.php:68
msgid "Image attachment IDs"
msgstr "ID’s van afbeeldingsbijlagen"

#: inc/class-githeme-gallery-slider-widget.php:70
msgid "Comma-separated attachment IDs, displayed in this order. Missing, deleted, and non-image attachments are skipped. One image remains a static gallery."
msgstr "Door komma’s gescheiden bijlage-ID’s, weergegeven in deze volgorde. Ontbrekende en verwijderde bijlagen en bijlagen die geen afbeeldingen zijn, worden overgeslagen. Bij één afbeelding blijft de galerij statisch."

#: inc/customizer.php:21
msgid "Enter a hexadecimal color such as #14569a."
msgstr "Voer een hexadecimale kleur in, zoals #14569a."

#: inc/customizer.php:34
msgid "Choose one of the available options."
msgstr "Kies een van de beschikbare opties."

#. translators: 1: minimum value, 2: maximum value, in rem.
#: inc/customizer.php:50
msgid "Enter a number from %1$s to %2$s rem."
msgstr "Voer een getal in van %1$s tot %2$s rem."

#. translators: %s: allowed increment in rem.
#: inc/customizer.php:53
msgid "Use increments of %s rem."
msgstr "Gebruik stappen van %s rem."

#: inc/customizer.php:76
msgid "Content width must not exceed wide width, and wide width must not exceed maximum layout width."
msgstr "De inhoudsbreedte mag niet groter zijn dan de breedte van de brede weergave, die niet groter mag zijn dan de maximale lay-outbreedte."

#: inc/customizer.php:90
msgid "Saved widths are invalid. Safe limits are applied only when rendering; saved values have not been changed."
msgstr "De opgeslagen breedtes zijn ongeldig. Veilige limieten worden alleen bij de weergave toegepast; de opgeslagen waarden zijn niet gewijzigd."

#: inc/customizer.php:94
msgid "Saved widths are inconsistent. Safe limits are applied only when rendering; saved values have not been changed."
msgstr "De opgeslagen breedtes zijn niet consistent. Veilige limieten worden alleen bij de weergave toegepast; de opgeslagen waarden zijn niet gewijzigd."

#: inc/customizer.php:100
msgid "Choose whether to display this item."
msgstr "Kies of dit item wordt getoond."

